.home-page {
  padding-top: 0;
}

.hero {
  position: relative;
  height: 520rpx;
  margin: 0 -28rpx;
  overflow: hidden;
}

.hero-image,
.hero-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-shade {
  background: linear-gradient(180deg, rgba(10, 24, 18, 0.12), rgba(10, 24, 18, 0.82));
}

.hero-copy {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  bottom: 42rpx;
  display: flex;
  flex-direction: column;
}

.eyebrow {
  margin-bottom: 14rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
  font-weight: 700;
}

.hero-title {
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1.12;
}

.hero-subtitle {
  width: 620rpx;
  max-width: 100%;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 27rpx;
  line-height: 1.55;
}

.quick-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
  margin-top: 28rpx;
}

.steps {
  padding: 24rpx;
}

.step {
  display: flex;
  gap: 20rpx;
  padding: 18rpx 0;
}

.step + .step {
  border-top: 1rpx solid #edf3ef;
}

.step-num {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  color: #147a58;
  background: #e4f7ef;
  font-size: 26rpx;
  font-weight: 900;
}

.step-title,
.favorite-name {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
}

.step-text,
.favorite-meta,
.empty,
.notice {
  color: #68756f;
  font-size: 26rpx;
  line-height: 1.55;
}

.favorite-list {
  display: grid;
  gap: 16rpx;
}

.favorite-card {
  padding: 24rpx;
}

.favorite-meta {
  display: block;
  margin-top: 8rpx;
}

.empty {
  padding: 26rpx;
}

.notice {
  margin-top: 28rpx;
  padding-bottom: 20rpx;
}
