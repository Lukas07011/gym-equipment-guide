<view class="page">
  <view class="library-head">
    <text class="library-title">器械图鉴</text>
    <text class="library-subtitle">知道名字就搜索，不知道名字就按训练部位浏览。</text>
  </view>

  <view class="search-card card">
    <input value="{{keyword}}" placeholder="搜索：推胸 / 下拉 / 腿举 / 划船" bindinput="onSearch" confirm-type="search" />
  </view>

  <scroll-view class="body-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="body-tabs">
      <button wx:for="{{bodyParts}}" wx:key="*this" class="body-tab {{selectedBody === item ? 'active' : ''}}" bindtap="selectBody" data-value="{{item}}">{{item}}</button>
    </view>
  </scroll-view>

  <view class="section-title">
    <text>常见器械</text>
    <text class="muted">{{filtered.length}} 台</text>
  </view>

  <view class="library-list">
    <view wx:for="{{filtered}}" wx:key="id" class="equipment-card card" bindtap="openDetail" data-id="{{item.id}}">
      <view class="equipment-top">
        <view>
          <text class="equipment-name">{{item.name}}</text>
          <text class="equipment-meta">{{item.bodyPartsText}} · {{item.level}}</text>
        </view>
        <text class="arrow">›</text>
      </view>
      <text class="equipment-motion">{{item.motion}}</text>
      <view class="feature-line">
        <text wx:for="{{item.featuresPreview}}" wx:key="*this" class="feature-pill">{{item}}</text>
      </view>
      <view class="card-footer">
        <text>查看调节方法和安全提醒</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!filtered.length}}" class="empty card">
    <text>没有找到对应器械。可以换一个更短的关键词，例如“拉”“推”“腿”。</text>
  </view>
</view>
