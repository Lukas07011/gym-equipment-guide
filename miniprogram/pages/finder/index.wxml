<view class="page">
  <view class="finder-head">
    <text class="title">我看到的是哪台器械？</text>
    <text class="subtitle">不用拍照，不用二维码。选几个你能观察到的特征，我会把可能的器械排出来。</text>
  </view>

  <view class="progress-card card">
    <view class="progress-top">
      <text>{{progressTitle}}</text>
      <text>{{progressPercent}}%</text>
    </view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{progressPercent}}%;"></view>
    </view>
    <text class="progress-copy">{{progressCopy}}</text>
  </view>

  <view class="section-title">
    <text>先选训练部位</text>
    <text class="muted">{{selectedBody}}</text>
  </view>
  <view class="chip-row">
    <button wx:for="{{bodyParts}}" wx:key="*this" class="chip {{selectedBody === item ? 'active' : ''}}" bindtap="selectBody" data-value="{{item}}">{{item}}</button>
  </view>

  <view class="section-title">
    <text>再选外观特征</text>
    <text class="muted">{{selectedFeatures.length}} 个</text>
  </view>
  <view class="chip-row">
    <button wx:for="{{featureOptions}}" wx:key="*this" class="chip {{selectedFeaturesMap[item] ? 'active' : ''}}" bindtap="toggleFeature" data-value="{{item}}">{{item}}</button>
  </view>

  <view class="action-row">
    <button class="ghost-button" bindtap="resetFilters">清空</button>
    <button class="primary-button" bindtap="goLibrary">看完整图鉴</button>
  </view>

  <view class="section-title">
    <text>{{resultTitle}}</text>
    <text class="muted">{{matches.length}} 个结果</text>
  </view>

  <view wx:if="{{matches.length}}" class="result-list">
    <view wx:for="{{matches}}" wx:key="id" class="result-card card" bindtap="openDetail" data-id="{{item.id}}">
      <image class="result-image" src="{{item.image}}" mode="aspectFill"></image>
      <view class="result-main">
        <text wx:if="{{index === 0 && isFocused}}" class="best-badge">最可能</text>
        <text class="result-name">{{item.name}}</text>
        <text class="result-motion">{{item.motion}}</text>
        <view class="tag-line">
          <text wx:for="{{item.matchedTags}}" wx:key="*this" class="mini-tag">{{item}}</text>
        </view>
      </view>
      <view class="score">
        <text>{{item.confidence}}</text>
        <text>{{item.score}}项</text>
      </view>
    </view>
  </view>
  <view wx:else class="empty card">
    <text>暂时没有匹配结果。可以少选几个特征，或去图鉴里按关键词搜索。</text>
  </view>
</view>
