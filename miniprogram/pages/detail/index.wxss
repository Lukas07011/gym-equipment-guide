.detail-page {
  padding-bottom: 156rpx;
}

.detail-head {
  overflow: hidden;
  padding: 0 0 28rpx;
}

.hero-equipment {
  display: block;
  width: 100%;
  height: 330rpx;
  margin-bottom: 26rpx;
  background: #eef8f3;
}

.detail-head > view {
  padding: 0 28rpx;
}

.level {
  display: inline-flex;
  margin-bottom: 14rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #147a58;
  background: #e4f7ef;
  font-size: 23rpx;
  font-weight: 800;
}

.name {
  display: block;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.15;
}

.meta {
  display: block;
  margin-top: 10rpx;
  color: #68756f;
  font-size: 27rpx;
}

.summary,
.info-card,
.safety,
.beginner,
.empty {
  margin-top: 18rpx;
  padding: 26rpx;
}

.summary {
  color: #3f5149;
  font-size: 29rpx;
  line-height: 1.65;
}

.summary-label {
  display: block;
  margin-bottom: 8rpx;
  color: #147a58;
  font-size: 24rpx;
  font-weight: 850;
}

.quick-facts {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 18rpx;
}

.fact {
  padding: 22rpx;
}

.fact-value {
  display: block;
  min-height: 38rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.fact-label {
  display: block;
  margin-top: 8rpx;
  color: #68756f;
  font-size: 24rpx;
}

.video-card {
  overflow: hidden;
  margin-top: 18rpx;
}

.demo-video,
.video-placeholder,
.video-poster {
  width: 100%;
  height: 360rpx;
}

.video-placeholder {
  position: relative;
  overflow: hidden;
  background: #eef8f3;
}

.video-poster {
  display: block;
}

.play-mark {
  position: absolute;
  left: 50%;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  color: #ffffff;
  background: rgba(20, 32, 27, 0.72);
  transform: translate(-50%, -50%);
}

.play-mark text {
  margin-left: 6rpx;
  font-size: 40rpx;
}

.video-copy {
  padding: 24rpx;
}

.video-title {
  display: block;
  font-size: 31rpx;
  font-weight: 850;
}

.video-status {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #8d321f;
  background: #ffe6df;
  font-size: 23rpx;
  font-weight: 800;
}

.shot-list {
  display: grid;
  gap: 14rpx;
  margin-top: 20rpx;
}

.shot-item {
  display: flex;
  gap: 14rpx;
  color: #3f5149;
  font-size: 26rpx;
  line-height: 1.5;
}

.shot-dot {
  flex: 0 0 12rpx;
  width: 12rpx;
  height: 12rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: #147a58;
}

.line,
.step-line {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  color: #2b3a34;
  font-size: 28rpx;
  line-height: 1.55;
}

.line + .line,
.step-line + .step-line {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf3ef;
}

.dot {
  flex: 0 0 12rpx;
  width: 12rpx;
  height: 12rpx;
  margin-top: 16rpx;
  border-radius: 50%;
  background: #147a58;
}

.warn .dot {
  background: #ff735c;
}

.step-index {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 42rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #147a58;
  font-size: 23rpx;
  font-weight: 900;
}

.safety {
  border-color: #ffd5ca;
  background: #fff3ef;
}

.safety-title,
.beginner-title {
  display: block;
  margin-bottom: 10rpx;
  font-size: 30rpx;
  font-weight: 850;
}

.safety-text,
.beginner,
.empty {
  color: #5d4038;
  font-size: 28rpx;
  line-height: 1.6;
}

.beginner {
  color: #14201b;
  background: #eef8f3;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  display: grid;
  grid-template-columns: 240rpx 1fr;
  gap: 16rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #dfe8e2;
  background: rgba(255, 255, 255, 0.96);
}

.bar-secondary,
.bar-primary {
  min-height: 84rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 850;
}

.bar-secondary {
  color: #147a58;
  background: #e4f7ef;
}

.bar-primary {
  color: #ffffff;
  background: #147a58;
}

.bar-primary.saved {
  background: #3f5149;
}
