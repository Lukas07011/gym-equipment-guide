<view wx:if="{{item}}" class="page detail-page">
  <view class="detail-head card">
    <image class="hero-equipment" src="{{item.image}}" mode="aspectFill"></image>
    <view>
      <text class="level">{{item.level}}</text>
      <text class="name">{{item.name}}</text>
      <text class="meta">{{item.bodyPartsText}}</text>
    </view>
  </view>

  <view class="summary card">
    <text class="summary-label">它是做什么的</text>
    <text>{{item.motion}}</text>
  </view>

  <view class="quick-facts">
    <view class="fact card">
      <text class="fact-value">{{item.level}}</text>
      <text class="fact-label">上手难度</text>
    </view>
    <view class="fact card">
      <text class="fact-value">{{primaryBody}}</text>
      <text class="fact-label">主要部位</text>
    </view>
  </view>

  <view class="section-title">
    <text>视频示例</text>
    <text class="muted">{{item.video.duration}}</text>
  </view>
  <view class="video-card card">
    <video wx:if="{{item.video.url}}" class="demo-video" src="{{item.video.url}}" poster="{{item.image}}" controls object-fit="cover"></video>
    <view wx:else class="video-placeholder">
      <image class="video-poster" src="{{item.image}}" mode="aspectFill"></image>
      <view class="play-mark">
        <text>▶</text>
      </view>
    </view>
    <view class="video-copy">
      <text class="video-title">{{item.video.title}}</text>
      <text class="video-status">{{item.video.status}}</text>
      <view class="shot-list">
        <view wx:for="{{item.video.shots}}" wx:key="*this" class="shot-item">
          <text class="shot-dot"></text>
          <text>{{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section-title">
    <text>先这样调</text>
  </view>
  <view class="info-card card">
    <view wx:for="{{item.setup}}" wx:key="*this" class="line">
      <text class="dot"></text>
      <text>{{item}}</text>
    </view>
  </view>

  <view class="section-title">
    <text>动作步骤</text>
  </view>
  <view class="info-card card">
    <view wx:for="{{item.steps}}" wx:key="*this" class="step-line">
      <text class="step-index">{{index + 1}}</text>
      <text>{{item}}</text>
    </view>
  </view>

  <view class="section-title">
    <text>常见错误</text>
  </view>
  <view class="info-card card">
    <view wx:for="{{item.mistakes}}" wx:key="*this" class="line warn">
      <text class="dot"></text>
      <text>{{item}}</text>
    </view>
  </view>

  <view class="safety card">
    <text class="safety-title">安全提醒</text>
    <text class="safety-text">{{item.safety}}</text>
  </view>

  <view class="beginner card">
    <text class="beginner-title">新手推荐</text>
    <text>{{item.beginner}}</text>
  </view>

  <view class="bottom-bar">
    <button class="bar-secondary" bindtap="goFinder">重新找器械</button>
    <button class="bar-primary {{isFavorite ? 'saved' : ''}}" bindtap="toggleFavorite">{{isFavorite ? '已收藏' : '收藏器械'}}</button>
  </view>
</view>

<view wx:else class="page">
  <view class="empty card">
    <text>没有找到这台器械。请回到图鉴重新选择。</text>
  </view>
</view>
